# dsh-message 本地覆盖配置（复制为 config/.env 后按需修改）
# 进程已有的环境变量优先于本文件；本文件只补充缺失项。
# Host 插件启动时也会加载本文件的 DSH_MESSAGE_* 段；渠道凭据与开关在 DSH“设置 → 插件 → 消息接入”页面配置。

# 以下 WX_BOT_* 仅遗留独立模式（node src/standalone/main.mjs，仅微信）使用。

# ── DSH 连接 ──
DSH_URL=http://127.0.0.1:3080
# DSH_STARTUP_CHECK_TIMEOUT_MS=3000

# ── 工作目录与会话 ──
# WX_BOT_CWD=E:\Research Files\研究生毕业论文\GSMR-Package\GSMR-MP-Manager-master-0708\GSMR-MP-AI-Agent-master\dsh-weixin
# WX_BOT_SESSION_DIR=
WX_BOT_WORKSPACE_TITLE=微信会话
# IM 渠道专用 DSH agent 预设：复制自 standard 并禁用 ask_user_question（Web 选项卡
# 提问），模型会在渠道内直接以文字编号提问（回复 1/2、1A 2B），手机用户无需鼠标。
# 插件安装/启动时会自动把该预设写入 $DSH_HOME/.agent-presets/dsh-message/。
WX_BOT_PRESET=dsh-message

# ── 功能开关 ──
WX_BOT_ENABLED=true
WX_BOT_STREAMING=true
WX_BOT_TYPING=true
WX_BOT_MEDIA=true
WX_BOT_RENEWAL=true

# ── 权限 ──
WX_BOT_ACCESS_POLICY=pairing
# WX_BOT_ALLOWLIST=
# WX_BOT_ADMINS=

# ── 气泡与流式 ──
# 单气泡长度上限（字符）：超过后即使模型没输出空行也强制切分
WX_BOT_STREAM_FLUSH_CHARS=2000
# 空闲超时（ms）：模型超过该时长没有新内容时，强制发出当前气泡
WX_BOT_STREAM_FLUSH_MS=8000
WX_BOT_SLOW_ACK_MS=4000
WX_BOT_TURN_TIMEOUT_MS=900000

# ── 微信客户端 ──
WX_BOT_CHUNK_SIZE=2000
WX_BOT_POLL_TIMEOUT_MS=8000
WX_BOT_WATCHDOG_MS=90000

# ── 模型路由 ──
# 以下值保留用于兼容旧配置；新的 DSH_MESSAGE_* 变量定义 Qwen 主通道与 Flash 兜底。
WX_BOT_FAST_MODEL=deepseek-official/deepseek-v4-flash
WX_BOT_FAST_REASONING=off
WX_BOT_COMPLEX_MODEL=deepseek-official/deepseek-v4-flash
WX_BOT_COMPLEX_REASONING=max
WX_BOT_COMPLEX_ACK_TEXT=好的，我先思考一下，稍后给你结果。

# ── 发送目录 ──
# WX_BOT_OUTBOX_DIR=

# dsh-message 五渠道统一模型与权限策略（Host 插件和独立模式均可读取）
# 主模型 id 已迁移到 Qwen-3.8-Flash-Next（vllm provider，baseURL 由 DSH settings.yaml 的
# llm-pi-ai.providers.vllm 决定）；写错会在启动时直接报错，不会静默退化。
DSH_MESSAGE_PERMISSION_PRESET=danger-full-access
DSH_MESSAGE_FAST_MODEL_PROVIDER=vllm
DSH_MESSAGE_FAST_MODEL=Qwen-3.8-Flash-Next
DSH_MESSAGE_FAST_REASONING=off
DSH_MESSAGE_COMPLEX_MODEL_PROVIDER=vllm
DSH_MESSAGE_COMPLEX_MODEL=Qwen-3.8-Flash-Next
DSH_MESSAGE_COMPLEX_REASONING=xhigh
DSH_MESSAGE_FALLBACK_MODEL_PROVIDER=deepseek-official
DSH_MESSAGE_FALLBACK_MODEL=deepseek-v4-flash
DSH_MESSAGE_FALLBACK_FAST_REASONING=off
DSH_MESSAGE_FALLBACK_COMPLEX_REASONING=max

# ── 浏览器（扫码窗口） ──
# WX_BOT_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
